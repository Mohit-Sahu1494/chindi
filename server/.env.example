# Server Port
PORT=5000

# Environment: development / production / test
NODE_ENV=development

# MongoDB Connection String (e.g. MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hisaab?retryWrites=true&w=majority

# JWT Secret Key
JWT_SECRET=hisaab_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=30d

# CORS Allowed Origin (use * for development or specific client URLs)
CORS_ORIGIN=*

# Firebase Admin SDK credentials for push notifications (JSON string or path to serviceAccountKey.json)
# Optional in development; when not provided, notifications operate via real-time WebSocket & in-app alerts.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# In-App Update Configuration
LATEST_APP_VERSION=1.0.1
LATEST_VERSION_CODE=2
MIN_REQUIRED_VERSION_CODE=1
APP_UPDATE_URL=https://github.com/mohit-sahu/chindi/releases/latest
APP_RELEASE_NOTES=Naye features, calculations me sudhar aur fast performance ke sath naya update uplabdh hai.
FORCE_UPDATE=false

