# Root gitignore for Chindi Project

# Dependencies
node_modules/
**/node_modules/

# Environment files
.env
.env.*
!.env.example

# Flutter & Dart artifacts
.dart_tool/
**/.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
**/build/

# Android build outputs & local config
**/android/.gradle/
**/android/local.properties
**/android/app/build/
*.keystore
*.jks

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
coverage/
**/coverage/
.nyc_output

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor files
.idea/
**/.idea/
.vscode/
**/.vscode/
*.iml
*.ipr
*.iws

# Sensitive Firebase Keys (service accounts)
serviceAccountKey.json
serviceAccountKey*.json
firebase-adminsdk*.json
*.pem
